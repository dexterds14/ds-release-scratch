LICENSE = "Proprietary"

DS_BRANCH ?= "main"
SRC_URI = "git://git@github.com/DistributedSpectrum/ds.git;protocol=ssh;branch=${DS_BRANCH}"

# Modify these as desired
SRCREV ?= "${DSREV}"
PV = "1.0+git${SRCPV}"
SRC_URI += "file://LICENSE.txt"
LIC_FILES_CHKSUM = "file://${WORKDIR}/LICENSE.txt;md5=59905deb64d89847d5ab59abaaee4558"

S = "${WORKDIR}/git/containers/ais_publisher"

inherit pkgconfig cmake

# ds-utils provides utils/log.h, common/, and third-party/ headers
DEPENDS += "zeromq protobuf ds-schemas ds-utils"
EXTRA_OECMAKE += " -DYOCTO_INCLUDE_SCHEMAS=${STAGING_INCDIR}/schemas \
                   -DCMAKE_PREFIX_PATH=${STAGING_LIBDIR}/cmake/absl \
                   -DSCARTHGAP_HACK=ON"

# The decoder it forks. Recommended, not required: without it the service
# logs that AIS-catcher is missing and idles, and ds stays a separate program
# from a GPL-3 one.
RRECOMMENDS:${PN} += "ais-catcher rtl-sdr"

FILES:${PN} += "/opt/ds/"

do_install() {
    install -d ${D}/opt/ds/bin
    install -m 0755 ${B}/ais_publisher ${D}/opt/ds/bin
}
