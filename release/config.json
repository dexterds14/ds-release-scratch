{
  "products": [
    "e2235"
  ],
  "product_prefix": false,
  "bookkeeping_files": [
    ".github/sdk.env"
  ],
  "artifact": {
    "kind": "debs",
    "debs": [
      "ds-sensor-portal"
    ],
    "deb_arch": "arm64",
    "deb_version_rule": "deb-version"
  },
  "version_probe": {
    "deb": "ds-sensor-portal",
    "path": "./opt/ds/sensor-portal/ds-sensor-portal",
    "pattern": "v{version}"
  },
  "merge_up": {
    "finish": {
      "strict": false,
      "required_checks": [
        "pr-checks"
      ],
      "check_sources": {
        "pr-checks": {
          "workflow": ".github/workflows/pr-checks.yml"
        }
      },
      "wait_minutes": 25
    },
    "never_auto": [
      ".github/workflows/**",
      "*sudoers*"
    ]
  }
}
